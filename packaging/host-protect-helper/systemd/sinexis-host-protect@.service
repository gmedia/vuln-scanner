[Unit]
Description=Sinexis Host Protect on-box poll (%i)
Requires=wazuh-agent.service
After=wazuh-agent.service

[Service]
Type=oneshot
Nice=15
TimeoutStartSec=180
# Lab/AM may start this oneshot many times; default 5/10s StartLimit refuses later polls.
StartLimitIntervalSec=0
EnvironmentFile=-/etc/sinexis/host-protect.env
ExecStart=/usr/bin/flock -n /var/lib/sinexis/host-protect-poll-%i.lock /usr/bin/python3 /usr/lib/sinexis/host-protect/sinexis_host_scan.py poll --agent-id %i
User=root
NoNewPrivileges=true
ProtectSystem=strict
# Quarantine dest + allowlisted web roots (S10 jail). Without these, os.rename fails closed.
# Leading '-' = ignore missing path (systemd 226/NAMESPACE if /srv/www absent).
ReadWritePaths=/var/lib/sinexis /var/www -/srv/www /home
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
