[Unit]
Description=Sinexis Host Protect on-box on-write watch (%i)
Requires=wazuh-agent.service
After=wazuh-agent.service
StartLimitIntervalSec=0

[Service]
Type=simple
Nice=15
Restart=always
RestartSec=10
EnvironmentFile=-/etc/sinexis/host-protect.env
ExecStart=/usr/bin/python3 /usr/lib/sinexis/host-protect/sinexis_host_scan.py watch --agent-id %i
User=root
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sinexis /var/www -/srv/www /home
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
