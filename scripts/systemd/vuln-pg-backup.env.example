# VulnScanner / Sinexis scheduled Postgres backup — environment file template.
#
# Copy to /etc/vuln-pg-backup.env, fill in real values, then:
#   sudo install -m 600 /dev/null /etc/vuln-pg-backup.env   # create empty 600
#   sudo chmod 600 /etc/vuln-pg-backup.env
# This file is read by vuln-pg-backup.service (EnvironmentFile=-/etc/vuln-pg-backup.env).
# NEVER commit a copy with real hosts, IPs, or secrets. Keep it mode 600.
#
# Uncomment the keys you need; the script has safe defaults for the rest.

# --- paths ----------------------------------------------------------------
# Repo checkout on this host (the systemd ExecStart expands ${DEPLOY_PATH}).
DEPLOY_PATH=/path/to/vuln-scanner
# App env file the script greps for POSTGRES_*/COS_* (never sourced).
# ENV_FILE=/path/to/vuln-scanner/.env

# --- Postgres access ------------------------------------------------------
# docker = local compose Postgres container (single host, no password needed).
# network = remote Postgres (multi-host); set PG_HOST + POSTGRES_PASSWORD.
PG_MODE=docker
# PG_CONTAINER=vuln-postgres
# PG_IMAGE=postgres:16-alpine
# PG_HOST=<data-host>
# PG_PORT=5432
# POSTGRES_USER=vuln_scanner
# POSTGRES_DB=vuln_scanner
# POSTGRES_PASSWORD=<db-password>       # network mode only; never printed

# --- local staging + retention -------------------------------------------
# Must match ReadWritePaths= in vuln-pg-backup.service if you change them.
# BACKUP_STAGE_DIR=/var/tmp/vuln-pg-backup
# BACKUP_LOCAL_DIR=/var/backups/vuln-scanner
# BACKUP_KEY_PREFIX=backups/
# BACKUP_RETENTION_DAYS=14

# --- encryption (one of age/gpg required unless opting into plaintext) ----
# Preferred: age public key; keep the private identity offline.
# BACKUP_AGE_RECIPIENT=age1<placeholder>
# Alternative: gpg recipient fingerprint/key id (public key imported on host).
# BACKUP_GPG_RECIPIENT=<gpg-recipient>
# Discouraged: explicitly allow an unencrypted dump.
# BACKUP_ALLOW_PLAINTEXT=0

# --- object storage uploader ---------------------------------------------
# Backend image source for the one-off COS uploader container.
# BACKUP_BACKEND_CONTAINER=vuln-backend
# Normally read from the app .env; set here only if not present there.
# OBJECT_STORAGE_BACKEND=cos
# COS_SECRET_ID=<placeholder>
# COS_SECRET_KEY=<placeholder>
# COS_REGION=<placeholder>
# COS_BUCKET=<placeholder>
# COS_APP_ID=<placeholder>
# COS_ENDPOINT=<placeholder>
# COS_PREFIX=<placeholder>
# COS_TIMEOUT_SEC=600

# --- debugging ------------------------------------------------------------
# Keep the staged artifact after a successful upload (0 = clean up).
# BACKUP_KEEP_STAGED=0

# --- restore (scripts/pg-restore.sh) -------------------------------------
# age private identity for .age archives (default keyring used if unset).
# BACKUP_AGE_IDENTITY=/etc/vuln-pg-backup/age.key
