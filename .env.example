# Environment variables for Vuln Scanner
# Copy this to .env and fill in values

# PostgreSQL
POSTGRES_DB=vuln_scanner
POSTGRES_USER=vuln_scanner
POSTGRES_PASSWORD=<your-postgres-password>

# Redis
REDIS_PASSWORD=<your-redis-password>

# Backend
DATABASE_URL=postgresql+asyncpg://vuln_scanner:<your-postgres-password>@postgres:5432/vuln_scanner
DATABASE_URL_SYNC=postgresql://vuln_scanner:<your-postgres-password>@postgres:5432/vuln_scanner
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/0

# API — ⚠️  MUST CHANGE IN PRODUCTION
# Generate strong key:
#   python3 -c "import secrets; print('sk_' + secrets.token_hex(32))"
# If unset, all API requests will be rejected.
API_KEY=<your-api-key-here>
# generate with: openssl rand -hex 32
SECRET_KEY=<your-secret-key-here>

# Comma-separated allowed CORS origins (frontend URLs)
# Default allows local dev servers + same-origin through nginx
CORS_ORIGINS=http://localhost:5173,http://localhost,http://localhost:8000

# Auth
JWT_SECRET=<your-jwt-secret-here>
# generate with: openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
# Set to true when running behind HTTPS/TLS
COOKIE_SECURE=false
NVD_API_KEY=  # optional fallback

# OSV (CVE database) — free, no API key needed
OSV_BASE_URL=https://api.osv.dev/v1

# Sentry (error tracking) — leave empty to disable
# Get your DSN at https://sentry.io
SENTRY_DSN=

# Maintenance auto-fail — min jobs in one run that trigger log.error + Sentry
AUTO_FAIL_ALERT_THRESHOLD=1

# Email / SMTP — production only; leave empty to disable
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sinexis <noreply@example.com>

# Frontend URL — used for password reset links etc.
FRONTEND_URL=https://your-domain.com

# Admin / e2e — upserted into users on deploy (password overwrite, not DB wipe)
ADMIN_EMAIL=<your-admin-email>
ADMIN_PASSWORD=<your-admin-password>
E2E_EMAIL=
E2E_PASSWORD=

# Credit System
DEFAULT_REGISTER_CREDITS=30
IP_SCAN_CREDIT_COST=1
DOMAIN_SCAN_CREDIT_COST=2
APK_SCAN_CREDIT_COST=3
IPA_SCAN_CREDIT_COST=3

# Mobile Scan
MOBSF_URL=  # optional MobSF integration
MAX_UPLOAD_SIZE_MB=500

# Object storage for mobile packages (default: local shared volume)
# local = path on disk / compose scan_data volume
# cos = Tencent COS (XML API); Celery arg becomes cos://<object-key>
OBJECT_STORAGE_BACKEND=local
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_APP_ID=
# Host only, e.g. cos.ap-singapore.myqcloud.com (optional; derived from region)
COS_ENDPOINT=
COS_PREFIX=scans/
COS_TIMEOUT_SEC=600

# Domain — used by nginx for server_name + certbot in dev
DOMAIN=localhost

# Frontend (empty = relative path through nginx, same-origin)
# VITE_API_URL=http://localhost:8000

# Guard / Wazuh thin (optional — leave empty + GUARD_MOCK_WAZUH=true for CI/dev)
GUARD_ENABLED=true
GUARD_MOCK_WAZUH=true
GUARD_ALERT_MIN_LEVEL=12
GUARD_ENROLL_TOKEN_TTL_HOURS=24
WAZUH_MANAGER_URL=
WAZUH_MANAGER_USER=
WAZUH_MANAGER_PASSWORD=
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
WAZUH_VERIFY_TLS=true
# Hostname/IP agents use to reach the manager (install snippet); not committed for real labs
WAZUH_AGENT_MANAGER_HOST=

# SIEM (P7) — search + cases; CI default off. Shared Wazuh URLs above. Not a Guard rewrite.
SIEM_ENABLED=false
SIEM_SEARCH_MIN_LEVEL=7
SIEM_MAX_LOOKBACK_HOURS=168
SIEM_INCLUDE_FULL_LOG=false
SIEM_MAX_PAGE_SIZE=50

# Multi-host (optional): Postgres/Redis on a dedicated data host
# - Set DATABASE_* and REDIS_*/CELERY_* to that host (see docs/multi-host-ops.md)
# - On the app host: REMOTE_DATA=1 ./scripts/deploy-services.sh
# - Bootstrap data host: APP_HOST_CIDR=<app-ip>/32 ./scripts/bootstrap-data-host.sh
# - GitHub Actions: set secret POSTGRES_HOST (default "postgres" keeps single-host compose)
# POSTGRES_HOST=postgres
# VITE_WS_URL=ws://localhost:8000
