[Unit]
Description=Sinexis Host Protect on-box poll (%i)
Requires=wazuh-agent.service
After=wazuh-agent.service

[Service]
Type=oneshot
Nice=15
TimeoutStartSec=180
EnvironmentFile=-/etc/sinexis/host-protect.env
ExecStart=/usr/bin/python3 /usr/lib/sinexis/host-protect/sinexis_host_scan.py poll --agent-id %i
User=root
NoNewPrivileges=true
ProtectSystem=strict
# Quarantine dest + allowlisted web roots (S10 jail). Without these, os.rename fails closed.
ReadWritePaths=/var/lib/sinexis /var/www /srv/www /home
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
