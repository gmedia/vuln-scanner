# Mode 600 after copy to /etc/sinexis/host-protect.env
# Never commit real tokens.
SINEXIS_API_BASE=https://sinexis.app
SINEXIS_HOST_AGENT_TOKEN=
SINEXIS_AGENT_ID=
SINEXIS_QUARANTINE_ROOT=/var/lib/sinexis/quarantine
# On-write watch (sinexis-host-watch@.service). Optional; inotify-tools
# (inotifywait) enables event mode, otherwise mtime sweep every 30s.
SINEXIS_WATCH_DEBOUNCE=60
SINEXIS_WATCH_COOLDOWN=900
SINEXIS_WATCH_STATE_DIR=/var/lib/sinexis/watch
SINEXIS_WATCH_ROOTS=
